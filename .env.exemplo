# Copie para .env e preencha. O .env esta no .gitignore: nao vai para o Git.
# NUNCA cole valor real NESTE arquivo -- ele e' versionado.
#
# SUPABASE_URL  -> Project Settings > API > Project URL
#                 (https://<id>.supabase.co, NAO a URL do painel)
# SERVICE_KEY   -> a chave SECRETA (service_role / Secret key)
# No Render estes mesmos nomes vao em Environment, nao neste arquivo.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=cole-aqui-a-chave-secreta-service_role
